extern fn emit(v: i32) stack 32 cycles 400
extern fn emitu(v: u32) stack 32 cycles 400
extern fn input_len() u32 stack 0 cycles 8
extern fn input_byte(i: u32) u8 stack 0 cycles 16

fn main()
  n := input_len()
  var v: u32 = 0
  var in_num: bool = false
  var over: bool = false
  for i in 0..n + 1
    var c: u8 = ' '
    if i < n
      c = input_byte(i)
    if c >= '0' && c <= '9'
      in_num = true
      digit := u32(c - '0')
      if !over
        if v > 429496729 || (v == 429496729 && digit > 5)
          over = true
        else
          v = v * 10 + digit
    else if c == ' ' || c == ','
      if in_num
        if over
          emit(-1)
        else
          emitu(v)
      in_num = false
      over = false
      v = 0
    else
      emit(-2)
      return
