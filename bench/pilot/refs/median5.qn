extern fn emit(v: i32) stack 32 cycles 400
extern fn emitu(v: u32) stack 32 cycles 400
extern fn input_len() u32 stack 0 cycles 8
extern fn input_byte(i: u32) u8 stack 0 cycles 16

fn s(i: u32) i32
  return i32(i8.wrap(input_byte(i)))

fn main()
  n := input_len()
  if n < 5
    return
  for i in 4..n
    var w: [5]i32 = [s(i - 4), s(i - 3), s(i - 2), s(i - 1), s(i)]
    for a in 0..5
      var less: u32 = 0
      var eq: u32 = 0
      for b in 0..5
        if w[b] < w[a]
          less += 1
        else if w[b] == w[a]
          eq += 1
      if less <= 2 && less + eq >= 3
        emit(w[a])
        break
