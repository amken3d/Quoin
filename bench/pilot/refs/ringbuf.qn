extern fn emit(v: i32) stack 32 cycles 400
extern fn emitu(v: u32) stack 32 cycles 400
extern fn input_len() u32 stack 0 cycles 8
extern fn input_byte(i: u32) u8 stack 0 cycles 16

fn main()
  n := input_len()
  var q: [8]u8
  var head: u32 = 0
  var count: u32 = 0
  for i in 0..n
    c := input_byte(i)
    if c < 0x80
      if count == 8
        emit(-1)
      else
        q[(head + count) % 8] = c
        count += 1
    else if count == 0
      emit(-2)
    else
      emitu(q[head % 8])
      head = (head + 1) % 8
      count -= 1
  emitu(count)
