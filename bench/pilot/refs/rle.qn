extern fn emit(v: i32) stack 32 cycles 400
extern fn emitu(v: u32) stack 32 cycles 400
extern fn input_len() u32 stack 0 cycles 8
extern fn input_byte(i: u32) u8 stack 0 cycles 16

fn main()
  n := input_len()
  var i: u32 = 0
  for i < n
    c := input_byte(i)
    var j: u32 = i
    for j < n && input_byte(j) == c && j - i < 255
      j += 1
    emitu(j - i)
    emitu(c)
    i = j
